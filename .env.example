# Shared environment for Agent 1 and Agent 2.
# Copy to .env, paste the key directly after `=` without quotes or spaces,
# and restart both agents. Never commit real credentials or patient data.
# Example format only (do not use this value): OPENAI_API_KEY=sk-your-key-here

OPENAI_API_KEY=
AGENT1_OPENAI_MODEL=gpt-5-mini
AGENT2_OPENAI_MODEL=gpt-4o-mini

# Optional Agent 1 fallback provider.
# Leave PROVIDER empty to select OpenAI automatically when a key is present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PROVIDER=

# Local integration ports.
AGENT1_PORT=3001
AGENT2_PORT=3000
AGENT1_API_URL=http://127.0.0.1:3001/api/agent2/timeline
AGENT1_API_TOKEN=
