# 複製成 .env 後填入金鑰即切換為真 LLM；兩把都沒填就自動用離線 mock 模式（demo 斷網備案）

# ── GPT API（主辦贊助商 OpenAI 的額度填這裡；設定後預設走 GPT）──
OPENAI_API_KEY=
# 選填：預設 gpt-5-mini；求品質可改 gpt-5，或依現場提供的模型名稱調整
OPENAI_MODEL=

# ── Claude API（備選）──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 選填：強制指定供應商 openai / anthropic / mock（不填則依上面金鑰自動判斷，OpenAI 優先）
PROVIDER=
PORT=3000
